{
  "name": "lab5-rest-api",
  "version": "1.0.0",
  "description": "Laboratory 5: REST API testing, variant 1",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "demo": "node --experimental-strip-types src/demo.ts",
    "test:lab4": "vitest run tests/order-service.test.ts tests/retry.test.ts tests/rate-provider.test.ts tests/cancellation-service.test.ts tests/payment-gateway.test.ts",
    "start": "tsx src/server.ts",
    "test:api": "vitest run --project api",
    "newman": "newman run postman/orders.postman_collection.json --reporters cli,junit,json --reporter-junit-export results/newman.xml --reporter-json-export results/newman.json"
  },
  "keywords": [],
